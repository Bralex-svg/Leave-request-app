DATABASE_URL=postgres://leaveflow:leaveflow@localhost:5433/leaveflow
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Email (Gmail SMTP via Nodemailer). Leave SMTP_USER/SMTP_PASS blank to
# have emails logged to the console instead of sent — useful for local dev.
# SMTP_PASS must be a Gmail "App Password" (myaccount.google.com/apppasswords),
# not your regular Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LeaveFlow <your-address@gmail.com>"
APP_URL=http://localhost:5173
