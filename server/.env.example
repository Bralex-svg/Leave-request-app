DATABASE_URL=postgres://leaveflow:leaveflow@localhost:5433/leaveflow
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Email, sent via Resend's HTTPS API (not SMTP — most free PaaS hosts,
# including Render's free tier, block outbound SMTP ports). Get a free API
# key at resend.com. Leave RESEND_API_KEY blank to have emails logged to
# the console instead of sent — useful for local dev. Until you verify your
# own sending domain with Resend, MAIL_FROM must stay as the sandbox address
# below, and delivery is restricted to the email you signed up to Resend with.
RESEND_API_KEY=
MAIL_FROM="LeaveFlow <onboarding@resend.dev>"
APP_URL=http://localhost:5173
